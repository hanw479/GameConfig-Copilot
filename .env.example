# GameConfig Copilot — 环境变量模板
#
# 用法：复制为 .env（`copy .env.example .env` / `cp .env.example .env`）后填入真实值。
# .env 与 .env.* 已在 .gitignore 中忽略（仅保留本模板），
# **不要把真实 API Key 写进 .env.example、文档、代码、测试或轨迹文件**；
# 误提交时立刻吊销并轮换密钥，清理 Git 历史不能替代吊销。
#
# 只有 GCC_LLM_API_KEY 是必填项；其余留空即用默认值。
# 变量由 src/gameconfig_copilot/config.py（pydantic-settings，前缀 GCC_）读取，
# 进程内已加载的配置有缓存，改完 .env 需重启进程。

# ---------- LLM 生成（必填：API Key） ----------
# deepseek | openai_compatible（内网 vLLM / 网关选后者，并显式给 BASE_URL）
GCC_LLM_PROVIDER=
# 模型名；换内部模型时改这里，业务代码无需改动
GCC_LLM_MODEL=deepseek-chat
# OpenAI 兼容网关地址；留空则用 provider 默认值，内网部署必须显式设置
# 例：http://10.0.0.8:8000/v1
GCC_LLM_BASE_URL=
# ===== 密钥：仅写在本机 .env，绝不提交 =====
# 留空即可先跑离线命令（ingest/search/schema）；涉及 LLM 的命令会在启动时
# 报 SettingsError 并指名 GCC_LLM_API_KEY，避免带着占位符去请求 401。
GCC_LLM_API_KEY=
# 单次请求超时（秒，>0 且 ≤600）
GCC_LLM_TIMEOUT_S=30

# ---------- MCP 写入闸门 ----------
# readonly（默认，fail-closed，commit_draft 不注册）| write（需显式开启）
# 这是**启动期**参数，不是运行期 API：prompt 无法在会话中把它提权。
GCC_MCP_MODE=readonly

# ---------- 服务与产物路径（一般无需修改） ----------
# 会话过期秒数，需 >0；默认 1800
# GCC_SESSION_TTL_S=1800
# 检索索引目录（`gcc ingest` 产物，默认 out/index，已被 .gitignore 忽略）
# GCC_INDEX_DIR=out/index
# 任务配置工作目录（写入闭环的目标根目录）
# GCC_TASKS_DIR=data/tasks
# JSONL 轨迹输出路径（含 trace_id，不含密钥）
# GCC_TRACE_PATH=traces/traces.jsonl
# 提示词目录覆盖；默认使用仓库内 prompts/
# GCC_PROMPTS_DIR=prompts
